class Solution(object):
    def stringMatching(self, words):
        """
        :type words: List[str]
        :rtype: List[str]
        """
        match = []
        for i in range(len(words)): 
            for j in range(len(words)):     
                if i == j: 
                  continue
                if words[i] in words[j]:  
                    match.append(words[i])  
                    break  
        return match
