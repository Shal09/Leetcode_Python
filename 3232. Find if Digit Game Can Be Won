class Solution(object):
    def canAliceWin(self, nums):
        """
        :type nums: List[int]
        :rtype: bool
        """
        single = 0
        double = 0
        for x in nums:
            if x < 10:
                single += x
            if x >= 10:
                double += x
        if single != double:
            return True
        else: return False
