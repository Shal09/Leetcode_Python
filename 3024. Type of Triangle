class Solution(object):
    def triangleType(self, nums):
        """
        :type nums: List[int]
        :rtype: str
        """
        nums.sort()
        if nums[0] + nums[1] <= nums[2]: return "none"
        if nums[1] == nums[0] == nums[2]:
            return "equilateral"
        if nums[1] == nums[0] or nums[1] == nums[2]:
            return "isosceles"
        else:
            return "scalene"
