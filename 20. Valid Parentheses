class Solution(object):
    def isValid(self, s):
        """
        :type s: str
        :rtype: bool
        """
        stack = []
        close_open = {')': '(', '}':'{',']':'['}
        for c in s:
            if c in close_open:
                if stack and stack[-1] == close_open[c]:
                    stack.pop()
                else: return False
            else: stack.append(c)
        return True if not stack else False
