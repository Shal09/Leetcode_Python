class Solution(object):
    def searchInsert(self, nums, target):
        """
        :type nums: List[int]
        :type target: int
        :rtype: int
        """

        left, right = 0, len(nums) - 1

        while left <= right:
            mid = (left + right) // 2  
            
            if nums[mid] == target:
                return mid  
            
            elif nums[mid] < target:
                left = mid + 1  
            
            else:
                right = mid - 1  

        return left 





NOTE:

left always points to where the target should be inserted.
If the target exists, left stops at its index.
If the target doesn’t exist, left moves to the correct insertion position.
right could be mid - 1, which might be an invalid position.
