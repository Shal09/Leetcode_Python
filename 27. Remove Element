class Solution(object):
    def removeElement(self, nums, val):
        """
        :type nums: List[int]
        :type val: int
        :rtype: int
        """
        l = 0
        n = len(nums)
        for i in range(n):
            if nums[i] != val:   
                nums[l] = nums[i] 
                l+= 1
        return l
