class Solution(object):
    def judgeCircle(self, moves):
        """
        :type moves: str
        :rtype: bool
        """
        row = 0
        col = 0
        for move in moves:
            if move == 'U':
                row += 1
            elif move == 'D':
                row -= 1
            elif move == 'L':
                col -= 1
            elif move == 'R':
                col +=  1
        return (row==0) and (col==0)
        
